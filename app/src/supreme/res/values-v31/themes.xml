<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+: launch themes for Supreme TV flavor.
      Replaces stock OwnTV animated icon and wordmark branding image with
      the official Supreme TV splash icon and removes the OwnTV branding image.
    -->
    <style name="Theme.OwnTVMobile.Starting.Petrol">
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
